{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bionativa",
  "main": "_worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "PROMOTIONS_KV",
      "id": "988a01e1bda74c57b3d27d22aff1cfa8"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
